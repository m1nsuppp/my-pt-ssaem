{
  "name": "my-pt-ssaem",
  "type": "module",
  "bin": {
    "my-pt-ssaem": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun --watch src/cli.ts",
    "serve": "bun run src/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "format": "bunx biome check --write .",
    "format:check": "bunx biome check .",
    "check": "tsc --noEmit && eslint . && biome check . && bun test"
  },
  "dependencies": {
    "@openrouter/agent": "0.9.0",
    "@openrouter/sdk": "0.13.67",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "eslint": "9.39.5",
    "eslint-config-love": "154.1.0",
    "typescript": "6.0.3"
  }
}
